{
  "name": "break-overlay",
  "version": "1.4.0",
  "description": "NBA / NFL / UCC break overlay pour OBS (Wheel, Draft, Tier).",
  "author": "fyrex-FR",
  "repository": {
    "type": "git",
    "url": "https://github.com/fyrex-FR/clim.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.fyrex.break-overlay",
    "productName": "Break Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "sport.js",
      "jszip.min.js",
      "tokens.css",
      "admin.html",
      "admin.css",
      "admin.js",
      "index.html",
      "style.css",
      "script.js",
      "draft.html",
      "draft.css",
      "draft.js",
      "tier.html",
      "tier.css",
      "tier.js",
      "sports.json",
      "modes.json",
      "tier-templates.json",
      "logo/**",
      "logo-nfl/**",
      "logo-ucc/**",
      "logo-ucc-carnaval-merlin/**",
      "flags/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "state.json",
        "to": "state.json"
      },
      {
        "from": "draft-state.json",
        "to": "draft-state.json"
      },
      {
        "from": "tier-state.json",
        "to": "tier-state.json"
      },
      {
        "from": "active-sessions.json",
        "to": "active-sessions.json"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fyrex-FR",
        "repo": "clim",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  }
}
